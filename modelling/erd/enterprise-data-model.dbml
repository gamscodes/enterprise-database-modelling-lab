
Table citizens {
  citizen_id bigint [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table citizen_profiles {
  citizen_id bigint [pk, not null, ref: > citizens.citizen_id]
  email_address varchar(255)
  phone_number varchar(30)
  address_line_1 varchar(200)
  address_line_2 varchar(200)
  city varchar(100)
  province_code varchar(2)
  postal_code varchar(10)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table application_types {
  application_type_id bigint [pk, increment]
  type_code varchar(30) [not null, unique]
  type_name varchar(150) [not null]
  description text
  application_fee numeric(12,2) [not null, default: 0.00]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table users {
  user_id bigint [pk, increment]
  username varchar(100) [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email_address varchar(255) [not null, unique]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table roles {
  role_id bigint [pk, increment]
  role_code varchar(50) [not null, unique]
  role_name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
}

Table applications {
  application_id bigint [pk, increment]
  citizen_id bigint [not null, ref: > citizens.citizen_id]
  application_type_id bigint [not null, ref: > application_types.application_type_id]
  application_number varchar(50) [not null, unique]
  current_status varchar(50) [not null]
  submitted_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    citizen_id [name: 'idx_applications_citizen_id']
    application_type_id [name: 'idx_applications_application_type_id']
    current_status [name: 'idx_applications_current_status']
  }
}

Table application_status_history {
  status_history_id bigint [pk, increment]
  application_id bigint [not null, ref: > applications.application_id]
  status_code varchar(50) [not null]
  changed_by_user_id bigint [ref: > users.user_id]
  changed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  reason text
  comments text

  indexes {
    application_id [name: 'idx_status_history_application_id']
    changed_at [name: 'idx_status_history_changed_at']
  }
}

Table documents {
  document_id bigint [pk, increment]
  document_type varchar(100) [not null]
  file_name varchar(255) [not null]
  file_reference varchar(500) [not null]
  uploaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  document_status varchar(50) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table application_documents {
  application_document_id bigint [pk, increment]
  application_id bigint [not null, ref: > applications.application_id]
  document_id bigint [not null, ref: > documents.document_id]
  document_purpose varchar(150)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (application_id, document_id) [unique, name: 'uq_application_documents']
    document_id [name: 'idx_application_documents_document_id']
  }
}

Table application_reviews {
  review_id bigint [pk, increment]
  application_id bigint [not null, ref: > applications.application_id]
  reviewer_user_id bigint [not null, ref: > users.user_id]
  review_status varchar(50) [not null]
  reviewed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  comments text

  indexes {
    application_id [name: 'idx_application_reviews_application_id']
    reviewer_user_id [name: 'idx_application_reviews_reviewer_user_id']
  }
}

Table application_approvals {
  approval_id bigint [pk, increment]
  application_id bigint [not null, ref: > applications.application_id]
  approver_user_id bigint [not null, ref: > users.user_id]
  decision varchar(30) [not null]
  decision_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  comments text

  indexes {
    application_id [name: 'idx_application_approvals_application_id']
    approver_user_id [name: 'idx_application_approvals_approver_user_id']
  }
}

Table payments {
  payment_id bigint [pk, increment]
  application_id bigint [not null, ref: > applications.application_id]
  payment_reference varchar(100) [not null, unique]
  amount numeric(12,2) [not null]
  payment_status varchar(50) [not null]
  paid_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    application_id [name: 'idx_payments_application_id']
    payment_status [name: 'idx_payments_payment_status']
  }
}

Table user_roles {
  user_role_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  role_id bigint [not null, ref: > roles.role_id]
  assigned_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  assigned_by_user_id bigint [ref: > users.user_id]

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles']
    role_id [name: 'idx_user_roles_role_id']
  }
}

Table audit_logs {
  audit_log_id bigint [pk, increment]
  user_id bigint [ref: > users.user_id]
  action_type varchar(100) [not null]
  entity_name varchar(100) [not null]
  record_id bigint
  event_timestamp timestamp [not null, default: `CURRENT_TIMESTAMP`]
  details text

  indexes {
    user_id [name: 'idx_audit_logs_user_id']
    event_timestamp [name: 'idx_audit_logs_event_timestamp']
  }
}
